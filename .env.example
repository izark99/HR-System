# Copy to .env.local and fill in. Never commit real values.
# Supabase project URL (also add its domain to connect-src in apps/web/public/_headers)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key only. NEVER put the service role key in any client env file.
VITE_SUPABASE_ANON_KEY=your-anon-key
