# Copy to apps/web/.env.local for `pnpm dev`. Production values come from Cloudflare Pages
# (Settings > Environment variables) at build time; nothing here is secret.
#
# Supabase project URL. Must match connect-src in apps/web/public/_headers.
VITE_SUPABASE_URL=https://rzakjtgvbyxqsmbpcomw.supabase.co
# Publishable key (sb_publishable_...), safe for the browser. NEVER put the service role /
# secret key (sb_secret_...) in any client env file: the app refuses to start with one.
VITE_SUPABASE_ANON_KEY=sb_publishable_LGUaSHynCBDHgwpW0AEe4g_6woV3e4K
# Dev only: "local" = bundled acceptance flow, no login, no server. Ignored in production builds.
# VITE_FLOW_SOURCE=local
